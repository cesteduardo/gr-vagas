# Sem DATABASE_URL, o desenvolvimento usa um Postgres embutido (PGlite) em .data/pg.
DATABASE_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:4820
# 1 só no lançamento: libera indexação no Google.
SITE_PUBLICO=0
# Em desenvolvimento o modo de demonstração liga sozinho. Nunca use 1 em produção real.
SIMULADOR=
# E-mails separados por vírgula que podem abrir /admin.
ADMIN_EMAILS=
# Alertas de vaga de hora em hora. Na demonstração rodam sozinhos dentro do servidor.
# Em produção, escolha UM: ALERTAS_AUTOMATICOS=1 (servidor sempre ligado) ou um cron
# externo chamando /api/cron/alertas com CRON_SEGREDO. Os dois juntos mandam e-mail em dobro.
ALERTAS_AUTOMATICOS=
# Protege /api/cron/alertas. Gere com: openssl rand -hex 32
CRON_SEGREDO=
# Envio de e-mail em produção. Ainda não testado com uma conta real.
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=
EMAIL_REMETENTE=
# Leitura de currículo e de vaga por IA. Sem chave, usa regras locais.
ANTHROPIC_API_KEY=
# Opcional: troca o modelo da leitura. Padrão: claude-opus-5-5.
MODELO_IA_VAGAS=

# Pagamento pelo Asaas (Pix e cartão). Sem a chave, as telas dizem que a assinatura está para chegar
# (ou simulam, na demonstração). ASAAS_AMBIENTE=producao usa a conta real; qualquer outro valor, o sandbox.
ASAAS_API_KEY=
ASAAS_AMBIENTE=sandbox
# Token do webhook (32+ caracteres), o mesmo cadastrado no Asaas para
# https://SEU_DOMINIO/api/pagamentos/asaas (ou .../vagas/api/pagamentos/asaas no grbrands).
ASAAS_WEBHOOK_TOKEN=
# Sem Asaas, a chave Pix mostrada no pedido de impulso.
PIX_CHAVE=
